// function va arrow function
function sum(a, b) {
    return a + b;
}

const sumArrow = (a, b) => a + b;

console.log(sum(2, 3));
console.log(sumArrow(2, 3));

// map va filter trong array
const products = [
    { id: 1, name: "Laptop", price: 20000000 },
    { id: 2, name: "Mouse", price: 500000 },
    { id: 3, name: "Keyboard", price: 1200000 }
];

const names = products.map(product => product.name);

const filtered = products.filter(
    product => product.price < 2000000
);

console.log(names);
console.log(filtered);
